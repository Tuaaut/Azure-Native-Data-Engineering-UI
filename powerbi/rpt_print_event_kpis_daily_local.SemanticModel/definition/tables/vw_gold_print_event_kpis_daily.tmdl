table vw_gold_print_event_kpis_daily
	lineageTag: 20387ec0-5912-4362-af87-a1aee8cf5be4

	measure 'Total Events' = SUM('vw_gold_print_event_kpis_daily'[total_events])
		formatString: #,0
		displayFolder: DAX Measures
		lineageTag: 66fcf513-1708-42c3-8a9e-76e3aa6a9652

	measure 'Successful Events' = SUM('vw_gold_print_event_kpis_daily'[successful_events])
		formatString: #,0
		displayFolder: DAX Measures
		lineageTag: c4008fd3-a467-4df4-9b92-bdd45bd4c612

	measure 'Rejected Events' = SUM('vw_gold_print_event_kpis_daily'[rejected_events])
		formatString: #,0
		displayFolder: DAX Measures
		lineageTag: c964e7ba-4972-41a1-8912-07f5ba7b18fd

	measure 'Success Rate %' = DIVIDE([Successful Events], [Total Events], 0)
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: DAX Measures
		lineageTag: 8336731a-462f-44d7-87aa-93235937e6dc

	measure 'Reject Rate %' = DIVIDE([Rejected Events], [Total Events], 0)
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: DAX Measures
		lineageTag: 914a6393-d8ae-4cc4-956a-b9a7bad91e2b

	measure 'Average Daily QR Grade Score' =
			
			DIVIDE(SUMX('vw_gold_print_event_kpis_daily', 'vw_gold_print_event_kpis_daily'[avg_qr_grade_score] * 'vw_gold_print_event_kpis_daily'[total_events]), SUM('vw_gold_print_event_kpis_daily'[total_events]), 0)
		formatString: #,0.00
		displayFolder: DAX Measures
		lineageTag: ab3662bc-8c5a-4eda-9894-2b9a151bb7f9

	measure 'Average Daily Position Error (mm)' =
			
			DIVIDE(SUMX('vw_gold_print_event_kpis_daily', 'vw_gold_print_event_kpis_daily'[avg_abs_position_error_mm] * 'vw_gold_print_event_kpis_daily'[total_events]), SUM('vw_gold_print_event_kpis_daily'[total_events]), 0)
		formatString: #,0.000
		displayFolder: DAX Measures
		lineageTag: 33a052ec-0554-4bd9-b279-9464a571b21e

